# Safe local-development placeholders only. Never place real credentials here.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://tawzeevo:change-me@localhost:5432/tawzeevo
TEST_DATABASE_URL=postgresql+psycopg://tawzeevo_test:change-me@localhost:5433/tawzeevo_test
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false
MEDIA_LOCAL_ROOT=.local-media
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_MAX_DIMENSION=6000
INVOICE_FUZZY_MATCH_THRESHOLD=0.7000
# Encrypted Google Drive backup. Generate a real key for any shared environment:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
BACKUP_MASTER_KEY=
BACKUP_KEK_ID=kek-local-1
BACKUP_DRIVE_PROVIDER=memory
BACKUP_SCHEDULER_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/backup/google/callback
VITE_API_BASE_URL=http://localhost:8000
VITE_STOREFRONT_BASE_URL=http://localhost:3000
VITE_DEMO_PREVIEW=false

POSTGRES_DB=tawzeevo
POSTGRES_USER=tawzeevo
POSTGRES_PASSWORD=change-me
POSTGRES_TEST_DB=tawzeevo_test
POSTGRES_TEST_USER=tawzeevo_test
POSTGRES_TEST_PASSWORD=change-me

# Public rate limits (requests per minute per IP; D-076 operational policy, defaults shown).
# PUBLIC_PRIVATE_RATE_LIMIT_PER_MINUTE=60
# PUBLIC_CATALOG_RATE_LIMIT_PER_MINUTE=600

# Online routing (D-060). Without a key the offline stop-order heuristic is used.
# OPENROUTESERVICE_API_KEY=
# ROUTING_TIMEOUT_SECONDS=8
